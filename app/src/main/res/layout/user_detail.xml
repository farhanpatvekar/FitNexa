<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D0C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/logo2"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/logo"
                android:scaleType="centerInside"
                android:contentDescription="FitNexa Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/appname5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FitNexa"
                    android:textColor="#B7E66A"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your fitness journey starts here"
                    android:textColor="#777D78"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:id="@+id/userdeatil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete Your Profile"
            android:textColor="#F1F3F1"
            android:textSize="29sp"
            android:textStyle="bold"
            android:layout_marginTop="42dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Help us personalize your fitness experience."
            android:textColor="#858B86"
            android:textSize="14sp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="30dp" />


        <!-- PERSONAL INFORMATION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERSONAL INFORMATION"
            android:textColor="#B7E66A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="14dp" />


        <!-- NAME -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="#171A18"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeColor="#292E2B"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#777D78"
            app:boxStrokeErrorColor="#B7E66A">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name1"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="textPersonName"
                android:textColor="#F1F3F1"
                android:textSize="16sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- AGE -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Age"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="#171A18"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeColor="#292E2B"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#777D78">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/age1"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="#F1F3F1"
                android:textSize="16sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- GENDER -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Gender"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="#171A18"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeColor="#292E2B"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#777D78">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gender1"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="Male / Female / Other"
                android:inputType="text"
                android:textColor="#F1F3F1"
                android:textColorHint="#5F6560"
                android:textSize="16sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- CONTACT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTACT INFORMATION"
            android:textColor="#B7E66A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="14dp" />


        <!-- EMAIL -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email Address"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="#121512"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeColor="#222622"
            app:hintTextColor="#626862">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email1"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="textEmailAddress"
                android:textColor="#8C928D"
                android:textSize="16sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:focusable="false"
                android:clickable="false" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- PHONE -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Phone Number"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="#171A18"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeColor="#292E2B"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#777D78">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phone1"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="phone"
                android:maxLength="10"
                android:textColor="#F1F3F1"
                android:textSize="16sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="32dp"
            android:text="Save &amp; Continue"
            android:textAllCaps="false"
            android:textColor="#10120F"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:backgroundTint="#B7E66A"
            app:cornerRadius="14dp"
            app:rippleColor="#D7F59A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Your information is kept secure"
            android:textColor="#555B56"
            android:textSize="12sp"
            android:layout_marginTop="14dp" />

    </LinearLayout>

</ScrollView>